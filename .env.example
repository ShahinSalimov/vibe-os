# Copy to .env and fill in (Supabase -> Project Settings -> API).
EXPO_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=YOUR-ANON-KEY
# Where booking-page/ is hosted, e.g. https://book.yourdomain.com
EXPO_PUBLIC_BOOKING_PAGE_URL=
# Where customers buy an activation code (Instagram / TikTok / WhatsApp link)
EXPO_PUBLIC_SELLER_CONTACT_URL=

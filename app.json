{
  "expo": {
    "name": "VIBE OS",
    "slug": "vibe-os",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.vibeos.app",
      "infoPlist": {
        "NSFaceIDUsageDescription": "VIBE OS uses Face ID to protect your data."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#0B0A10",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.vibeos.app"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-localization",
      "expo-secure-store",
      [
        "expo-local-authentication",
        {
          "faceIDPermission": "VIBE OS uses Face ID to protect your data."
        }
      ],
      [
        "expo-speech-recognition",
        {
          "microphonePermission": "VIBE OS uses the microphone so you can add events and records by voice.",
          "speechRecognitionPermission": "VIBE OS converts your voice to text to fill in events and records.",
          "androidSpeechServicePackages": [
            "com.google.android.googlequicksearchbox"
          ]
        }
      ],
      "expo-audio",
      [
        "expo-image-picker",
        {
          "photosPermission": "VIBE OS uses your photos so you can choose a profile picture.",
          "cameraPermission": false,
          "microphonePermission": false
        }
      ],
      "expo-sharing",
      [
        "expo-notifications",
        {
          "color": "#F5B841"
        }
      ],
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 180,
          "backgroundColor": "#0B0A10",
          "resizeMode": "contain"
        }
      ]
    ],
    "backgroundColor": "#0B0A10"
  }
}